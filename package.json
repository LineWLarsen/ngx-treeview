{
  "name": "ngx-treeview-workspace",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "contributors": [
    "Charmedme",
    "LineWLarsen"
  ],
  "description": "Workspace for @linewlarsen/ngx-treeview (library + demo app)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:demo": "ng build angular-ngx-treeview --aot --output-hashing=all --base-href /ngx-treeview/",
    "build": "ng build ngx-treeview",
    "publish:lib": "npm run build && npm publish ./dist/ngx-treeview --access public",
    "test": "ng test",
    "deploy": "npm run build:demo && node gh-pages.js"
  },
  "author": "Charmedme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LineWLarsen/ngx-treeview.git"
  },
  "bugs": {
    "url": "https://github.com/LineWLarsen/ngx-treeview/issues"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "bootstrap": "^5.0.0",
    "lodash": "^4.17.21",
    "rxjs": "^7.5.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@types/jasmine": "^4.0.3",
    "@types/lodash": "^4.14.182",
    "@types/node": "^24.0.0",
    "gh-pages": "^6.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^4.1.1",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.1.1",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.0.1",
    "karma-jasmine-html-reporter": "^2.0.0",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3",
    "zone.js": "^0.16.3"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true
  }
}
